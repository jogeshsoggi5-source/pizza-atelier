# Environment Configuration Template
# Copy to .env.local for local development and fill in your values

# Development Mode
NODE_ENV=development

# Supabase Configuration
# Get these values from your Supabase project settings:
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Settings > API > Project URL and API keys

# Public/Client-side Supabase variables (safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase variables (KEEP IN .env.local ONLY!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
